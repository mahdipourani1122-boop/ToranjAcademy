# تنظیمات هسته جنگو
DJANGO_SECRET_KEY=replace-with-64-char-production-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# کلید اختصاصی رمزنگاری اسرار TOTP در دیتابیس (۳۲ بایت هگز یا رشته تصادفی)
DJANGO_TOTP_ENCRYPTION_KEY=replace-with-32-byte-secret-encryption-key

# تنظیمات دیتابیس (در صورت خالی بودن DB_ENGINE از SQLite استفاده می‌شود)
DB_ENGINE=
DB_NAME=toranj_db
DB_USER=toranj_user
DB_PASSWORD=replace-with-db-password
DB_HOST=127.0.0.1
DB_PORT=5432

# تنظیمات سرویس‌دهنده واقعی پیامک (SMS OTP Provider)
# مقادیر مجاز SMS_PROVIDER: kavenegar | melipayamak | webhook
SMS_PROVIDER=
SMS_API_KEY=your-real-sms-provider-api-key
SMS_SENDER_NUMBER=10008663
SMS_OTP_TEMPLATE=toranj-otp-verify
SMS_WEBHOOK_URL=https://api.sms-provider.example/v1/send

# تنظیمات سرور ایمیل (SMTP) برای بازیابی رمز عبور
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@toranjacademy.ir
EMAIL_HOST_PASSWORD=replace-with-smtp-password
DEFAULT_FROM_EMAIL=TORANJ Academy <noreply@toranjacademy.ir>